{
  "name": "football-score-machine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:artifact": "vite build && node scripts/build-artifact.mjs",
    "test": "vitest run",
    "db:status": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/supabase.mjs status",
    "db:migrate": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/supabase.mjs migrate",
    "db:test": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/supabase.mjs test",
    "fn:deploy": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/supabase.mjs deploy",
    "fn:test": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node scripts/live-test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
